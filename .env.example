# ---------- Backend (Spring Boot) ----------
SPRING_PROFILES_ACTIVE=local
DB_URL=jdbc:postgresql://localhost:5432/folio-db
DB_USERNAME=postgres
DB_PASSWORD=your-local-password
# At least 32 characters. Generate one with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-secret-of-32-plus-chars
# false only for local http; production keeps the default (true)
AUTH_COOKIE_SECURE=false
# Comma-separated origins of the web app
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Load the demo library into an empty database
FOLIO_DEMO_DATA=true
PORT=8080

# ---------- Integration tests (optional; Testcontainers is used when unset) ----------
# TEST_DB_URL=jdbc:postgresql://localhost:5432/folio_test
# TEST_DB_USERNAME=postgres
# TEST_DB_PASSWORD=your-local-password

# ---------- Frontend (frontend/.env.local) ----------
# The web app proxies /api/* to this origin, so the browser only talks to one site.
API_ORIGIN=http://localhost:8080
